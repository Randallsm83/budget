# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# agent/editor tool configs - these get rewritten with RESOLVED literal
# credentials by MCP tooling; keep them local-only (see .env.local)
.claude.json
.mcp.json
.claude/
.cursor/
.aider*

# key/cert material (*.pem covered above)
*.key
*.crt
*.p12
*.pfx

# local data exports (transactions, balances)
*.csv
*.sqlite
*.db

# signed policy docs at repo root - real name, email, signature block,
# and local workstation paths; keep local, do not publish
/*.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# one-off admin/data-fix scripts (keep locally, do not commit)
scripts/fix-*.ts
scripts/cleanup-*.ts
scripts/list-*.ts
scripts/merge-*.ts
scripts/reset-*.ts
scripts/show-*.ts

# un-ignore src/lib (blocked by global gitignore lib/ rule)
!src/lib/
!src/lib/**

.vercel

# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# PostgreSQL connection string (Neon, Supabase, or local)
# Get from: https://neon.tech or https://supabase.com
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=your-auth-secret-here

# App URL (used by Auth.js for redirects)
NEXTAUTH_URL=http://localhost:3000

# --- Plaid (optional — only needed for bank import) ---
# Get from: https://dashboard.plaid.com
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-production-secret
PLAID_SANDBOX_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox   # sandbox | development | production

# OAuth redirect URI — required for OAuth-based institutions
# Must be registered in the Plaid dashboard
PLAID_REDIRECT_URI=https://yourdomain.com/oauth-callback

# Publicly reachable URL Plaid will POST webhooks to
# Use ngrok or similar for local dev: https://abc123.ngrok.io/api/plaid/webhook
PLAID_WEBHOOK_URL=https://yourdomain.com/api/plaid/webhook

# 64 hex chars (32 bytes) for AES-256-GCM encryption of Plaid tokens and MFA secrets
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-key-here

# --- Seed script (used by: npm run db:seed) ---
# Set before running the seed. SEED_USER_PASSWORD becomes the login password.
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-immediately
SEED_USER_NAME=Your Name
# OAuth redirect URI — required when using OAuth-based institutions with Plaid
PLAID_REDIRECT_URI=

# --- Seed script (used by: npm run db:seed) ---
# Set these before running the seed for the first time.
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-immediately
SEED_USER_NAME=Your Name
